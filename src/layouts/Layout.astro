---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Bob Le | kaabob',
  description = 'Software engineer, chess master, and jiu-jitsu practitioner. Building software and technology. Working remotely on projects worldwide.',
} = Astro.props;

const canonicalURL = 'https://kaabob.com';
const ogImage = `${canonicalURL}/logo.png`;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="theme-color" content="#000000" />

    <!-- Security -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Google Fonts — non-render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      var l = document.createElement('link');
      l.rel = 'stylesheet';
      l.href = 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Inter:wght@300;400&display=swap';
      document.head.appendChild(l);
    </script>

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Bob Le",
        "url": "https://kaabob.com",
        "jobTitle": "Software Engineer",
        "description": "Software engineer, chess master, and jiu-jitsu practitioner. Building software and technology. Working remotely on projects worldwide.",
        "knowsAbout": ["Software Development", "Web Design", "Technical Consulting"],
        "sameAs": [
          "https://stellarcapture.com",
          "https://www.thebuilderbob.com"
        ]
      }
    </script>

    <!-- Removes no-js before first paint so CSS animations only apply with JS -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div id="cursor" aria-hidden="true"></div>
    <div id="cursor-follower" aria-hidden="true"></div>

    <slot />

    <script>
      import { gsap } from '../scripts/gsap-init.ts';

      const cursor = document.getElementById('cursor');
      const follower = document.getElementById('cursor-follower');
      const canHover = window.matchMedia('(hover: hover)').matches;

      if (canHover && cursor && follower) {
        gsap.set([cursor, follower], { x: -200, y: -200 });

        const xCursor = gsap.quickTo(cursor, 'x', { duration: 0.05, ease: 'none' });
        const yCursor = gsap.quickTo(cursor, 'y', { duration: 0.05, ease: 'none' });
        const xFollower = gsap.quickTo(follower, 'x', { duration: 0.35, ease: 'power3.out' });
        const yFollower = gsap.quickTo(follower, 'y', { duration: 0.35, ease: 'power3.out' });

        window.addEventListener('mousemove', (e: MouseEvent) => {
          xCursor(e.clientX);
          yCursor(e.clientY);
          xFollower(e.clientX);
          yFollower(e.clientY);
        });

        document.querySelectorAll('a, button, [role="button"]').forEach((el) => {
          el.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
          el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
        });
      }
    </script>
  </body>
</html>
