---
import { Image } from 'astro:assets';
import logoSrc from '../assets/logo.png';

const nameChars = 'Bob Le'.split('');
---

<section
  id="hero"
  class="relative min-h-svh flex flex-col items-center justify-center bg-black px-6"
  aria-labelledby="hero-name"
>
  <div id="hero-logo" class="mb-14" style="will-change: transform, opacity">
    <Image
      src={logoSrc}
      alt="kaabob"
      width={84}
      height={84}
      densities={[1, 2, 3]}
      format="webp"
      quality={100}
      fetchpriority="high"
      loading="eager"
      style="filter: invert(1); display: block"
    />
  </div>

  <h1
    id="hero-name"
    class="font-display font-light text-white text-center mb-14"
    style="font-size: clamp(3.75rem, 9vw, 7.5rem); letter-spacing: -0.04em; line-height: 0.95"
    aria-label="Bob Le"
  >
    {
      nameChars.map((char) => (
        <span class="js-char" aria-hidden="true">
          {char === ' ' ? '\u00A0' : char}
        </span>
      ))
    }
  </h1>

  <span class="ink-rule ink-rule--dark mb-10" id="hero-rule" aria-hidden="true"></span>

  <p
    id="hero-tagline"
    class="opacity-0 font-display font-light text-white text-center"
    style="font-size: clamp(1rem, 2.5vw, 1.375rem); letter-spacing: 0.06em; font-style: italic"
  >
    Made in Vietnam. Assembled in Texas.
  </p>

  <div
    id="hero-scroll"
    class="opacity-0 absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4"
  >
    <span
      class="font-body text-white"
      style="font-size: 0.52rem; letter-spacing: 0.45em; text-transform: uppercase"
    >
      Scroll
    </span>
    <span
      id="scroll-line"
      class="block w-px bg-white"
      style="height: 36px; transform-origin: top; transform: scaleY(0)"
      aria-hidden="true"
    ></span>
  </div>
</section>

<script>
  import { gsap } from '../scripts/gsap-init.ts';

  const logo = document.getElementById('hero-logo');
  const chars = document.querySelectorAll<HTMLElement>('#hero-name .js-char');
  const rule = document.getElementById('hero-rule');
  const tagline = document.getElementById('hero-tagline');
  const scrollIndicator = document.getElementById('hero-scroll');
  const scrollLine = document.getElementById('scroll-line');

  // Initial states set via JS (not CSS) so elements are visible on first paint for LCP
  gsap.set(logo, { scale: 0.88, opacity: 0 });
  gsap.set(chars, { opacity: 0, clipPath: 'inset(0 110% 0 0)' });

  const tl = gsap.timeline({ delay: 0.1 });

  tl.to(logo, { opacity: 1, scale: 1, duration: 1.0, ease: 'power4.out' }, 0);
  tl.to(
    chars,
    { opacity: 1, clipPath: 'inset(0 0% 0 0)', duration: 0.55, stagger: 0.06, ease: 'power3.out' },
    0.6,
  );
  tl.to(rule, { width: 44, duration: 0.75, ease: 'power4.inOut' }, 1.4);
  tl.to(tagline, { opacity: 1, duration: 0.6, ease: 'power3.out' }, 1.6);
  tl.to(scrollIndicator, { opacity: 1, duration: 0.5, ease: 'power3.out' }, 2.1);

  tl.then(() => {
    if (!scrollLine) return;
    gsap.to(scrollLine, { scaleY: 1, duration: 0.7, ease: 'power2.inOut', repeat: -1, repeatDelay: 0.5, yoyo: true });
  });
</script>
